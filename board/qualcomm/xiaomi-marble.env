bootdelay=0
bootretry=1
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

# Fastboot is keen to use the address from kconfig, but we
# allocate its buffer at runtime.
fastboot=fastboot -l $fastboot_addr_r usb 0

# Always probe for UFS storage and bring up the USB serial console.
# The usbacm console does not wait for a host (USB_FUNCTION_ACM_NOWAIT),
# so this is harmless without a cable; output is buffered until the
# host opens /dev/ttyACM0.
preboot=scsi scan; run serial_on; run others_next

serial_on=setenv stdin serial,button-kbd,usbacm; \
	setenv stdout serial,vidconsole,usbacm; \
	setenv stderr serial,vidconsole,usbacm

# Show the boot menu with a 5 second countdown; any key (volume or
# power button, or a key on the serial console) stops it. The default
# entry is bootmenu_0 (postmarketOS). Afterwards bootcmd re-opens the
# menu without a timeout, so a failed boot never loops.
bootcmd=setenv bootcmd run menucmd; bootmenu 5

# postmarketOS: /boot lives on the GPT partition labelled "esp" on UFS LUN 0
# and carries an extlinux.conf next to the files boot-deploy installs.
pmos_boot=part number scsi 0 esp esp_part && \
	sysboot scsi 0:${esp_part} any ${pxefile_addr_r} /extlinux/extlinux.conf

# Android (slot a) on UFS LUN 4: boot_a + vendor_boot_a + dtbo_a, DTB and
# DTBO entry 0 (ro.boot.dtb_idx/dtbo_idx on this phone). The images go to
# the 6 GiB bank at 0x9_0000_0000, which has no carveouts. U-Boot moves the
# androidboot.* arguments from bootargs into the bootconfig section.
# The raw arm64 Image is executed in place (default kernel_addr in the header),
# 4 KiB behind the boot image header, and must start 2 MiB aligned: load the
# image one page below a 2 MiB boundary.
android_boot_addr=0x9001ff000
android_vboot_addr=0x910000000
android_dtbo_addr=0x918000000
android_lun=4
android_load=part size scsi ${android_lun} boot_a sz && \
	read scsi ${android_lun}#boot_a ${android_boot_addr} 0 ${sz} && \
	part size scsi ${android_lun} vendor_boot_a sz && \
	read scsi ${android_lun}#vendor_boot_a ${android_vboot_addr} 0 ${sz} && \
	part size scsi ${android_lun} dtbo_a sz && \
	read scsi ${android_lun}#dtbo_a ${android_dtbo_addr} 0 ${sz}
android_fdt=abootimg addr ${android_boot_addr} ${android_vboot_addr} && \
	abootimg get dtb --index=0 android_dtb android_dtb_size && \
	fdt move ${android_dtb} ${fdt_addr_r} 0x200000 && \
	fdt addr ${fdt_addr_r} && \
	adtimg addr ${android_dtbo_addr} && \
	adtimg get dt --index=0 android_ovl && \
	fdt apply ${android_ovl}
android_args=setenv bootargs androidboot.slot_suffix=_a androidboot.hardware=qcom \
	androidboot.boot_devices=soc/1d84000.ufshc \
	androidboot.bootdevice=1d84000.ufshc \
	androidboot.serialno=${serial#} androidboot.baseband=msm \
	androidboot.keymaster=1 androidboot.dtb_idx=0 androidboot.dtbo_idx=0 \
	androidboot.verifiedbootstate=orange \
	androidboot.vbmeta.device_state=unlocked \
	androidboot.force_normal_boot=0 androidboot.fstab_suffix=default \
	androidboot.memcg=1 androidboot.usbcontroller=a600000.dwc3 \
	androidboot.hardware.sku=marble androidboot.product.hardware.sku=marble \
	androidboot.hwc=GL androidboot.hwlevel=MP androidboot.hwversion=15.19.0 \
	androidboot.hardware.revision=GL_MP_15.19.0 \
	androidboot.product.vendor.sku=ukee androidboot.oled_wp=0001040b00020004 \
	hwid.hwid_value=1638400 hwid.project=15 \
	msm_drm.dsi_display0=qcom,mdss_dsi_m16t_36_02_0a_dsc_vid: \
	msm_drm.oled_wp=0001040b00020004 rootwait ro init=/init
android_boot=echo "Loading Android (slot a)..." && run android_load && \
	run android_fdt && run android_args && \
	bootm ${android_boot_addr} ${android_boot_addr} ${fdt_addr_r}

# Other operating systems, managed from Linux by port/marble-port: the esp file
# /extlinux/others.env holds the "Other systems" submenu (bootmenu_0..9 lines,
# imported only when the submenu opens) and an optional one-shot selection
# (next_title/next_boot) that becomes the default entry of the next boot. The
# booted system clears the one-shot (marble-oneshot-clear.service), so a broken
# system cannot capture the phone: the following boot is postmarketOS again.
# Only these variables are imported from the file.
others_file=part number scsi 0 esp esp_part && \
	load scsi 0:${esp_part} ${pxefile_addr_r} /extlinux/others.env
others_next=if run others_file; then \
	env import -t ${pxefile_addr_r} ${filesize} next_title next_boot; \
	if test -n "${next_boot}"; then \
		setenv bootmenu_0 "${next_title} (one-shot)=run next_boot; pause"; \
		setenv bootmenu_11 "Boot postmarketOS=run pmos_boot; pause"; \
	fi; \
	fi
others_menu=if run others_file; then \
	env delete -f bootmenu_0 bootmenu_1 bootmenu_2 bootmenu_3 bootmenu_4 bootmenu_5 \
		bootmenu_6 bootmenu_7 bootmenu_8 bootmenu_9 bootmenu_10 bootmenu_11; \
	env import -t ${pxefile_addr_r} ${filesize} bootmenu_0 bootmenu_1 bootmenu_2 \
		bootmenu_3 bootmenu_4 bootmenu_5 bootmenu_6 bootmenu_7 bootmenu_8 bootmenu_9; \
	bootmenu; \
	else echo "no /extlinux/others.env on the esp"; pause; \
	fi; reset

# When entering the menu (either from button press or failed boot)
# remap bootcmd so it will re-open the menu and we won't get stuck
# at the console with no way to type
menucmd=setenv bootcmd run menucmd; bootmenu -1

# Pause is used so the output can be read on the display
bootmenu_0=Boot postmarketOS=run pmos_boot; pause
bootmenu_1=Other systems...=run others_menu
bootmenu_2=Serial console shell (USB ttyACM)=run serial_on; setenv bootretry -1; echo "U-Boot shell on the USB serial console (ttyACM0)"
bootmenu_3=Enable USB mass storage=echo "Press any key to exit UMS mode"; ums 0 scsi 0
bootmenu_4=Enable fastboot mode=echo "Press any key to exit fastboot mode"; run fastboot
# Disabling bootretry means we'll just drop the shell
bootmenu_5=Drop to shell=setenv bootretry -1
bootmenu_6=Reset device=reset
bootmenu_7=Power off=poweroff
bootmenu_8=Dump environment=printenv; pause
bootmenu_9=Board info=bdinfo; pause
bootmenu_10=Dump bootargs=fdt addr $fdt_addr_r; fdt print /chosen bootargs; pause

# Allow holding the volume down button while U-Boot loads to enter
# the boot menu without the countdown
button_cmd_0_name=Volume Down
button_cmd_0=run menucmd

# Configuration fragment for Xiaomi Poco F5 (marble)
CONFIG_DEFAULT_DEVICE_TREE="qcom/sm8475-xiaomi-marble"
CONFIG_CLK_QCOM_SM8450=y
CONFIG_PINCTRL_QCOM_SM8450=y
CONFIG_USB_FUNCTION_ACM=y
CONFIG_USB_GADGET=y
CONFIG_USB_GADGET_DOWNLOAD=y
CONFIG_USB_FUNCTION_MASS_STORAGE=y
CONFIG_LNX_KRNL_IMG_TEXT_OFFSET_BASE=0x0
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/qualcomm/xiaomi-marble.env"
CONFIG_CMD_SYSBOOT=y
CONFIG_USB_FUNCTION_ACM_NOWAIT=y
CONFIG_CMD_READ=y
CONFIG_CMD_ABOOTIMG=y
CONFIG_CMD_ADTIMG=y
CONFIG_OF_LIBFDT_OVERLAY=y
CONFIG_QCOM_PREFER_PREVBL_MEMORY=y
